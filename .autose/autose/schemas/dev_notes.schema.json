{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dev_notes",
  "type": "object",
  "properties": {
    "summary": {
      "type": "string"
    },
    "files_changed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "deviations_from_design": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "contested_tests": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "test_id": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "test_id",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "self_check": {
      "type": "string"
    }
  },
  "required": [
    "summary",
    "files_changed",
    "deviations_from_design",
    "contested_tests",
    "self_check"
  ],
  "additionalProperties": false
}
