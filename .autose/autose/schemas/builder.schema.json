{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "builder",
  "type": "object",
  "properties": {
    "dev_notes": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "string"
        },
        "files_changed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "deviations_from_design": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "contested_tests": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "test_id": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            },
            "required": [
              "test_id",
              "reason"
            ],
            "additionalProperties": false
          }
        },
        "self_check": {
          "type": "string"
        }
      },
      "required": [
        "summary",
        "files_changed",
        "deviations_from_design",
        "contested_tests",
        "self_check"
      ],
      "additionalProperties": false
    },
    "test_map": {
      "type": "object",
      "properties": {
        "test_file": {
          "type": "string"
        },
        "mapping": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ac": {
                "type": "string"
              },
              "tests": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "ac",
              "tests"
            ],
            "additionalProperties": false
          }
        },
        "notes": {
          "type": "string"
        }
      },
      "required": [
        "test_file",
        "mapping",
        "notes"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "dev_notes",
    "test_map"
  ],
  "additionalProperties": false
}
